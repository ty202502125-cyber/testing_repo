      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;650;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root { --cc-board:#f1f3ed; --cc-paper:#fbfcf8; --cc-white:#fff; --cc-ink:#202a25; --cc-muted:#59675f; --cc-faint:#738078; --cc-line:#dbe2dc; --cc-forest:#173e31; --cc-green:#17684f; --cc-green-soft:#e4f0e9; --cc-amber:#8e5b11; --cc-amber-soft:#fff2d9; --cc-red:#a84138; --cc-red-soft:#f9e8e3; --cc-shadow:0 20px 50px rgba(27,47,36,.08); }\n.board { margin:0; min-height:100vh; background:var(--cc-board); color:var(--cc-ink); font-family:'DM Sans',sans-serif; }\n.board-inner { width:min(1380px,100%); margin:0 auto; padding:42px 38px 34px; }\n.board-head { display:flex; justify-content:space-between; align-items:flex-start; gap:28px; padding:4px 2px 30px; }\n.brand-lock { display:flex; align-items:center; gap:12px; }\n.brand-stamp { width:42px;height:42px;display:grid;place-items:center;background:var(--cc-forest);color:#fff;font:600 23px 'Newsreader',serif;border-radius:12px 12px 12px 4px; }\n.brand-copy { font-size:16px; font-weight:650; letter-spacing:-.03em; line-height:1.1; }\n.brand-copy small { display:block; margin-top:5px; color:var(--cc-muted); font-size:11px; font-weight:500; letter-spacing:.015em; }\n.board-title { max-width:860px; margin:26px 0 0; font:500 clamp(34px,4vw,48px)/1.04 'Newsreader',serif; letter-spacing:-.035em; color:#1f3028; }\n.board-dek { max-width:760px; margin:12px 0 0; font-size:16px; line-height:1.65; color:var(--cc-muted); }\n.board-meta { display:flex; align-items:center; gap:10px; padding-top:3px; color:var(--cc-muted); font-size:13px; white-space:nowrap; }\n.meta-mark { width:9px;height:9px;border-radius:50%;background:var(--cc-green); }\n.preview-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22px; align-items:start; }\n.preview-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin:0 2px 12px; }\n.preview-heading h2 { margin:0; font:500 24px/1.1 'Newsreader',serif; letter-spacing:-.02em; color:#20332a; }\n.preview-heading span { color:var(--cc-muted); font-size:13px; }\n.preview-window { border:1px solid #d9e0d9; border-radius:16px; overflow:hidden; background:var(--cc-paper); box-shadow:var(--cc-shadow); }\n.window-bar { height:36px; display:flex; align-items:center; gap:6px; padding:0 13px; background:#f8f9f5; border-bottom:1px solid var(--cc-line); }\n.window-dot { width:7px;height:7px;border-radius:50%; background:#bbc7bf; }\n.window-label { margin-left:5px;color:#738078;font-size:11px; }\n.product-screen { min-height:760px; display:grid; grid-template-columns:150px minmax(0,1fr); }\n.screen-sidebar { background:#fff; border-right:1px solid var(--cc-line); padding:16px 11px 13px; display:flex; flex-direction:column; }\n.screen-brand { display:flex;align-items:center;gap:8px;margin:0 3px 25px;color:var(--cc-ink);font-size:13px;font-weight:650;letter-spacing:-.025em; }\n.screen-brand-mark { width:27px;height:27px;border-radius:8px 8px 8px 3px;display:grid;place-items:center;background:var(--cc-green);color:#fff;font:600 17px 'Newsreader',serif; }\n.screen-brand small { display:block;color:var(--cc-faint);font-size:8px;letter-spacing:.1em;font-weight:600;margin-top:2px; }\n.screen-nav { display:grid;gap:3px; }\n.screen-nav a { min-height:37px;display:flex;align-items:center;gap:8px;padding:0 8px;border-radius:7px;text-decoration:none;color:#526158;font-size:11.5px;font-weight:500;white-space:nowrap; }\n.screen-nav a.active { background:var(--cc-green-soft);color:var(--cc-green);font-weight:650; }\n.screen-nav .ti { display:inline-grid;place-items:center;width:17px;height:17px;font-size:15px;color:#718078;flex:none; }\n.screen-nav a.active .ti { color:var(--cc-green); }\n.sidebar-spacer { flex:1; min-height:18px; }\n.account-chip { display:flex;align-items:center;gap:8px;border-top:1px solid var(--cc-line);padding:11px 1px 0; }\n.avatar { width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#e4eee7;color:var(--cc-green);font-size:10px;font-weight:700;flex:none; }\n.account-text { min-width:0; }\n.account-text b { display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--cc-ink);font-size:10.5px;font-weight:650; }\n.account-text small { display:block;margin-top:2px;color:var(--cc-faint);font-size:9px; }\n.screen-main { min-width:0; padding:20px 21px 22px; }\n.screen-topline { display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:15px;margin-bottom:20px;border-bottom:1px solid var(--cc-line);color:var(--cc-muted);font-size:11px; }\n.screen-topline strong { color:#34453b;font-weight:600; }\n.screen-topline .context { display:flex;align-items:center;gap:9px;min-width:0; }\n.screen-topline .context span+strong { padding-left:9px;border-left:1px solid #cad4cd;white-space:nowrap; }\n.screen-topline .user-short { display:flex;align-items:center;gap:7px;color:#33443a;white-space:nowrap; }\n.screen-topline .user-short .avatar { width:25px;height:25px;font-size:9px; }\n.screen-main h1 { margin:0; font:500 29px/1.12 'Newsreader',serif; letter-spacing:-.03em;color:#20342a; }\n.screen-lede { margin:6px 0 18px;color:var(--cc-muted);font-size:12px;line-height:1.55; }\n.task-label { display:flex;align-items:center;gap:8px;color:#426453;font-size:11px;font-weight:650; }\n.task-label .line { width:16px;height:1px;background:#86a895; }\n.next-task { margin-top:17px;background:#edf3ed;border:1px solid #d6e3d9;border-radius:10px;padding:17px 17px 14px; }\n.task-main { display:grid;grid-template-columns:minmax(0,1fr) 62px;gap:13px;align-items:start;margin-top:11px; }\n.activity-category { color:#527061;font-size:10px;font-weight:600; }\n.task-main h2 { margin:4px 0 7px;color:#20372c;font:500 23px/1.12 'Newsreader',serif;letter-spacing:-.02em; }\n.task-description { margin:0;color:#52635a;font-size:11px;line-height:1.45; }\n.date-stamp { min-height:67px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;border:1px solid #cfdbd1;border-radius:7px;color:#244536; }\n.date-stamp small { font-size:9px;letter-spacing:.08em;font-weight:700; }\n.date-stamp b { font:500 28px/.95 'Newsreader',serif; }\n.task-facts { display:flex;flex-wrap:wrap;gap:8px 15px;margin:12px 0 13px;color:#45584c;font-size:10.5px; }\n.task-facts span { display:flex;align-items:center;gap:5px; }\n.task-facts .ti { width:15px;height:15px;display:inline-grid;place-items:center;font-size:13px;color:#3f7059; }\n.available-text { display:flex;align-items:center;gap:7px;margin-top:1px;color:#345b46;font-size:10.5px;font-weight:600; }\n.available-dot { width:7px;height:7px;border-radius:50%;background:#33845e; }\n.action-button { min-height:39px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 13px;border:0;border-radius:7px;background:var(--cc-forest);color:#fff;text-decoration:none;font-size:11px;font-weight:600;white-space:nowrap; }\n.action-button .ti { font-size:14px; }\n.service-summary { margin:19px 0 22px;display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--cc-line);border-bottom:1px solid var(--cc-line); }\n.summary-item { display:flex;align-items:baseline;gap:9px;padding:11px 10px 11px 2px; }\n.summary-item+.summary-item { padding-left:14px;border-left:1px solid var(--cc-line); }\n.summary-value { color:#22392d;font:500 25px/.95 'Newsreader',serif;white-space:nowrap; }\n.summary-copy { color:var(--cc-muted);font-size:10px;line-height:1.35; }\n.summary-copy strong { display:block;color:#34483b;font-size:10.5px;font-weight:650; }\n.summary-copy .pending-word { color:var(--cc-amber); }\n.upcoming-head { display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin:0 0 6px; }\n.upcoming-head h2 { margin:0;color:#24382d;font:500 18px/1.1 'Newsreader',serif; }\n.quiet-link { display:inline-flex;align-items:center;gap:5px;color:#286b52;text-decoration:none;font-size:10.5px;font-weight:600;white-space:nowrap; }\n.quiet-link .ti { font-size:13px; }\n.agenda-list { margin-top:6px; }\n.agenda-row { display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #e4e9e4; }\n.agenda-date { color:#4e6c59;font-size:9px;font-weight:700;line-height:1.25;letter-spacing:.035em; }\n.agenda-date b { display:block;color:#294a38;font:500 20px/.95 'Newsreader',serif;letter-spacing:0; }\n.agenda-copy { min-width:0; }\n.agenda-copy strong { display:block;color:#283c31;font-size:11px;font-weight:600; }\n.agenda-copy small { display:block;margin-top:3px;color:#617067;font-size:9.5px;line-height:1.35; }\n.agenda-spots { color:#4e6d58;font-size:9.5px;white-space:nowrap; }\n\n.queue-intro { display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:0 0 14px; }\n.queue-intro h1 { margin:0; }\n.queue-intro p { margin:6px 0 0;color:var(--cc-muted);font-size:11.5px;line-height:1.45; }\n.queue-count { display:flex;align-items:baseline;gap:6px;flex:none;color:#244b38; }\n.queue-count b { font:500 34px/.9 'Newsreader',serif; }\n.queue-count span { max-width:64px;color:#627067;font-size:9.5px;line-height:1.2; }\n.review-table { margin-top:17px;border-top:1px solid #bdcabe; }\n.table-head { display:grid;grid-template-columns:minmax(0,1fr) 45px 145px;gap:10px;padding:9px 0;color:#718078;font-size:9px;font-weight:650; }\n.table-head span:last-child { text-align:right; }\n.review-row { padding:12px 0 11px;border-top:1px solid #e0e6e0; }\n.review-top { display:grid;grid-template-columns:minmax(0,1fr) 45px;align-items:center;gap:10px; }\n.student-identity { display:flex;align-items:center;gap:8px;min-width:0; }\n.student-identity .avatar { width:29px;height:29px; }\n.student-name { min-width:0; }\n.student-name b { display:block;color:#27392f;font-size:11px;font-weight:650; }\n.student-name small { display:block;margin-top:2px;color:#68766d;font-size:9px; }\n.claim-hours { color:#243b2e;font:500 20px/1 'Newsreader',serif;text-align:right;white-space:nowrap; }\n.claim-hours small { font:500 10px 'DM Sans',sans-serif;color:#647167; }\n.review-activity { margin:8px 0 0 37px;color:#3e5146;font-size:10px;line-height:1.45; }\n.review-activity strong { color:#2b4034;font-weight:600; }\n.review-activity small { display:block;margin-top:2px;color:#67756c;font-size:9px; }\n.review-actions { display:flex;align-items:center;gap:8px;margin:9px 0 0 37px; }\n.approve-action,.decline-action { min-height:31px;display:inline-flex;align-items:center;justify-content:center;gap:5px;border-radius:6px;padding:0 10px;font-family:'DM Sans',sans-serif;font-size:10px;font-weight:600; }\n.approve-action { background:#e5f0e8;border:1px solid #bad1bf;color:#245d3e; }\n.decline-action { background:#fff;border:1px solid #d9ded9;color:#677168; }\n.approve-action .ti,.decline-action .ti { font-size:12px; }\n.admin-links { display:flex;align-items:center;gap:17px;margin-top:19px;padding-top:12px;border-top:1px solid var(--cc-line); }\n.admin-links a { display:inline-flex;align-items:center;gap:6px;color:#355342;text-decoration:none;font-size:10.5px;font-weight:600; }\n.admin-links .ti { width:15px;height:15px;display:inline-grid;place-items:center;font-size:13px;color:#64806e; }\n.state-strip { display:grid;grid-template-columns:180px repeat(3,minmax(0,1fr));align-items:center;gap:14px;margin-top:23px;padding:15px 19px;background:#e9ede6;border:1px solid #d9e0d8;border-radius:10px; }\n.state-title { color:#34483b;font-size:13px;font-weight:650; }\n.state-title small { display:block;margin-top:3px;color:#68766d;font-size:10px;font-weight:400; }\n.state-item { display:flex;align-items:center;gap:9px;color:#44554a;font-size:11px;line-height:1.35; }\n.state-symbol { width:9px;height:9px;border-radius:50%;background:#39845a;flex:none; }\n.state-item.pending .state-symbol { background:#c38827; }\n.state-item.full .state-symbol { background:#8b938d; }\n.state-item strong { display:block;color:#283d31;font-size:11.5px;font-weight:650; }\n.board-footer { display:flex;justify-content:space-between;gap:16px;margin:15px 2px 0;color:#68746b;font-size:11px; }\n.board-footer strong { color:#41584a;font-weight:600; }\n/* Larger operational type and touch-ready actions keep the previews readable. */\n.board-meta .meta-mark { display:none; }\n.screen-nav a { min-height:42px;font-size:12.5px; }\n.screen-brand small { font-size:9px; }\n.account-text b { font-size:11.5px; }\n.account-text small { font-size:10px; }\n.screen-topline,.window-label { font-size:12px; }\n.screen-lede,.queue-intro p { font-size:13px; }\n.task-label,.activity-category { font-size:12px; }\n.task-description { font-size:12px; }\n.task-facts,.available-text { font-size:11.5px; }\n.action-button { min-height:44px;font-size:12px; }\n.summary-copy { font-size:11.5px; }\n.summary-copy strong { font-size:12px; }\n.upcoming-head h2 { font-size:19px; }\n.quiet-link,.admin-links a { font-size:12px; }\n.agenda-date { font-size:10.5px; }\n.agenda-copy strong { font-size:12px; }\n.agenda-copy small,.agenda-spots { font-size:10.5px; }\n.table-head { display:none; }\n.student-name b { font-size:12px; }\n.student-name small,.review-activity small { font-size:10.5px; }\n.review-activity { font-size:11.5px; }\n.approve-action,.decline-action { min-height:40px;font-size:11.5px; }\n.admin-links .ti { width:16px;height:16px; }\n@media (max-width:1050px) { .board-inner {padding:30px 22px;} .preview-grid {grid-template-columns:1fr;} .preview-window {max-width:790px;} .preview-heading {max-width:790px;} .state-strip {grid-template-columns:1fr 1fr;} }\n@media (max-width:600px) { .board-inner {padding:24px 14px;} .board-head {display:block;padding-bottom:24px;} .board-meta {margin-top:18px;} .board-title {font-size:36px;} .product-screen {grid-template-columns:116px minmax(0,1fr);} .screen-sidebar {padding:13px 8px;} .screen-main {padding:17px 13px;} .screen-nav a {gap:5px;padding:0 5px;font-size:11px;white-space:normal;} .screen-brand {font-size:11px;gap:6px;} .screen-brand small {font-size:8px;} .screen-topline {font-size:10px;} .screen-main h1 {font-size:25px;} .task-main {grid-template-columns:minmax(0,1fr) 54px;} .task-main h2 {font-size:20px;} .state-strip {grid-template-columns:1fr;} .board-footer {flex-direction:column;} }\n</style>\n<div class=\"board\" data-kid=\"1\" data-name=\"page layout container\">\n    <main class=\"board-inner\" data-kid=\"1-1\" data-name=\"main content area\">\n        <header class=\"board-head\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div data-kid=\"1-1-1-1\" data-name=\"brand and title container\">\n                <div class=\"brand-lock\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo and name\">\n                    <span class=\"brand-stamp\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo initial\">\n                        C\n                    </span>\n                    <div class=\"brand-copy\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name text\">\n                        Campus Connect\n                        <small data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand tag line\">\n                            STUDENT COMMUNITY\n                        </small>\n                    </div>\n                </div>\n                <h1 class=\"board-title\" data-kid=\"1-1-1-1-2\" data-name=\"main board headline\">\n                    A calmer desk for community work.\n                </h1>\n                <p class=\"board-dek\" data-kid=\"1-1-1-1-3\" data-name=\"board description text\">\n                    Put the next useful student opportunity first. Give admins a clear, evidence-led place to review hours.\n                </p>\n            </div>\n            <div class=\"board-meta\" data-kid=\"1-1-1-2\" data-name=\"dashboard status meta\">\n                <span class=\"meta-mark\" data-kid=\"1-1-1-2-1\" data-name=\"status indicator dot\">\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"dashboard status text\">\n                    Shared system · two role-specific workflows\n                </span>\n            </div>\n        </header>\n        <section aria-label=\"Student and administrator dashboard previews\" class=\"preview-grid\" data-kid=\"1-1-2\" data-name=\"dashboard preview section\">\n            <article data-kid=\"1-1-2-1\" data-name=\"student dashboard preview article\">\n                <div class=\"preview-heading\" data-kid=\"1-1-2-1-1\" data-name=\"student preview header\">\n                    <h2 data-kid=\"1-1-2-1-1-1\" data-name=\"student preview heading\">\n                        Student overview\n                    </h2>\n                    <span data-kid=\"1-1-2-1-1-2\" data-name=\"student preview subtext\">\n                        Find a good next step\n                    </span>\n                </div>\n                <div class=\"preview-window\" data-kid=\"1-1-2-1-2\" data-name=\"student preview window\">\n                    <div class=\"window-bar\" data-kid=\"1-1-2-1-2-1\" data-name=\"window chrome bar\">\n                        <span class=\"window-dot\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"window dot icon\">\n                        </span>\n                        <span class=\"window-dot\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"window dot icon\">\n                        </span>\n                        <span class=\"window-dot\" data-kid=\"1-1-2-1-2-1-3\" data-name=\"window dot icon\">\n                        </span>\n                        <span class=\"window-label\" data-kid=\"1-1-2-1-2-1-4\" data-name=\"window label text\">\n                            Campus Connect · Student space\n                        </span>\n                    </div>\n                    <div class=\"product-screen\" data-kid=\"1-1-2-1-2-2\" data-name=\"product screen container\">\n                        <aside class=\"screen-sidebar\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"screen sidebar\">\n                            <div class=\"screen-brand\" data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"sidebar brand\">\n                                <span class=\"screen-brand-mark\" data-kid=\"1-1-2-1-2-2-1-1-1\" data-name=\"sidebar brand initial\">\n                                    C\n                                </span>\n                                <span data-kid=\"1-1-2-1-2-2-1-1-2\" data-name=\"sidebar brand text\">\n                                    Campus Connect\n                                    <small data-kid=\"1-1-2-1-2-2-1-1-2-1\" data-name=\"sidebar brand tag line\">\n                                        STUDENT COMMUNITY\n                                    </small>\n                                </span>\n                            </div>\n                            <nav aria-label=\"Student navigation\" class=\"screen-nav\" data-kid=\"1-1-2-1-2-2-1-2\" data-name=\"main navigation\">\n                                <a class=\"active\" data-kid=\"1-1-2-1-2-2-1-2-1\" data-name=\"nav link\" href=\"#student\">\n                                    <i class=\"ti ti-home\" data-kid=\"1-1-2-1-2-2-1-2-1-1\" data-name=\"nav icon\">\n                                    </i>\n                                    Overview\n                                </a>\n                                <a data-kid=\"1-1-2-1-2-2-1-2-2\" data-name=\"nav link\" href=\"#student\">\n                                    <i class=\"ti ti-compass\" data-kid=\"1-1-2-1-2-2-1-2-2-1\" data-name=\"nav icon\">\n                                    </i>\n                                    Discover activities\n                                </a>\n                                <a data-kid=\"1-1-2-1-2-2-1-2-3\" data-name=\"nav link\" href=\"#student\">\n                                    <i class=\"ti ti-file-text\" data-kid=\"1-1-2-1-2-2-1-2-3-1\" data-name=\"nav icon\">\n                                    </i>\n                                    My service record\n                                </a>\n                            </nav>\n                            <div class=\"sidebar-spacer\" data-kid=\"1-1-2-1-2-2-1-3\" data-name=\"sidebar spacer\">\n                            </div>\n                            <div class=\"account-chip\" data-kid=\"1-1-2-1-2-2-1-4\" data-name=\"user account chip\">\n                                <span class=\"avatar\" data-kid=\"1-1-2-1-2-2-1-4-1\" data-name=\"avatar\">\n                                    MS\n                                </span>\n                                <span class=\"account-text\" data-kid=\"1-1-2-1-2-2-1-4-2\" data-name=\"user account text\">\n                                    <b data-kid=\"1-1-2-1-2-2-1-4-2-1\" data-name=\"user name\">\n                                        Maya Santos\n                                    </b>\n                                    <small data-kid=\"1-1-2-1-2-2-1-4-2-2\" data-name=\"user role\">\n                                        Student volunteer\n                                    </small>\n                                </span>\n                            </div>\n                        </aside>\n                        <div class=\"screen-main\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"screen main content\" id=\"student\">\n                            <div class=\"screen-topline\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"screen top information bar\">\n                                <div class=\"context\" data-kid=\"1-1-2-1-2-2-2-1-1\" data-name=\"screen navigation context\">\n                                    <span data-kid=\"1-1-2-1-2-2-2-1-1-1\" data-name=\"context parent label\">\n                                        Student space\n                                    </span>\n                                    <strong data-kid=\"1-1-2-1-2-2-2-1-1-2\" data-name=\"current page label\">\n                                        Overview\n                                    </strong>\n                                </div>\n                                <span class=\"user-short\" data-kid=\"1-1-2-1-2-2-2-1-2\" data-name=\"shortened user info\">\n                                    <span class=\"avatar\" data-kid=\"1-1-2-1-2-2-2-1-2-1\" data-name=\"small avatar\">\n                                        MS\n                                    </span>\n                                    Maya Santos\n                                </span>\n                            </div>\n                            <h1 data-kid=\"1-1-2-1-2-2-2-2\" data-name=\"main screen heading\">\n                                Good morning, Maya.\n                            </h1>\n                            <p class=\"screen-lede\" data-kid=\"1-1-2-1-2-2-2-3\" data-name=\"main screen description\">\n                                Here’s the next activity with places still available.\n                            </p>\n                            <section aria-label=\"Next open opportunity\" class=\"next-task\" data-kid=\"1-1-2-1-2-2-2-4\" data-name=\"next opportunity callout\">\n                                <div class=\"task-label\" data-kid=\"1-1-2-1-2-2-2-4-1\" data-name=\"opportunity label\">\n                                    <span class=\"line\" data-kid=\"1-1-2-1-2-2-2-4-1-1\" data-name=\"ornamental line\">\n                                    </span>\n                                    Next open opportunity\n                                </div>\n                                <div class=\"task-main\" data-kid=\"1-1-2-1-2-2-2-4-2\" data-name=\"opportunity details\">\n                                    <div data-kid=\"1-1-2-1-2-2-2-4-2-1\" data-name=\"opportunity meta\">\n                                        <div class=\"activity-category\" data-kid=\"1-1-2-1-2-2-2-4-2-1-1\" data-name=\"activity category\">\n                                            ENVIRONMENT · GREEN CAMPUS SOCIETY\n                                        </div>\n                                        <h2 data-kid=\"1-1-2-1-2-2-2-4-2-1-2\" data-name=\"activity title\">\n                                            Coastal Cleanup Morning\n                                        </h2>\n                                        <p class=\"task-description\" data-kid=\"1-1-2-1-2-2-2-4-2-1-3\" data-name=\"activity summary text\">\n                                            Help clear plastic waste and restore the shoreline. Gloves, bags, and refreshments provided.\n                                        </p>\n                                    </div>\n                                    <div class=\"date-stamp\" data-kid=\"1-1-2-1-2-2-2-4-2-2\" data-name=\"date stamp\">\n                                        <small data-kid=\"1-1-2-1-2-2-2-4-2-2-1\" data-name=\"day of week\">\n                                            SUN\n                                        </small>\n                                        <b data-kid=\"1-1-2-1-2-2-2-4-2-2-2\" data-name=\"day of month\">\n                                            04\n                                        </b>\n                                        <small data-kid=\"1-1-2-1-2-2-2-4-2-2-3\" data-name=\"month name\">\n                                            OCT\n                                        </small>\n                                    </div>\n                                </div>\n                                <div class=\"task-facts\" data-kid=\"1-1-2-1-2-2-2-4-3\" data-name=\"opportunity factual highlights\">\n                                    <span data-kid=\"1-1-2-1-2-2-2-4-3-1\" data-name=\"time info\">\n                                        <i class=\"ti ti-clock\" data-kid=\"1-1-2-1-2-2-2-4-3-1-1\" data-name=\"clock icon\">\n                                        </i>\n                                        7:30–11:30\n                                    </span>\n                                    <span data-kid=\"1-1-2-1-2-2-2-4-3-2\" data-name=\"location info\">\n                                        <i class=\"ti ti-map-pin\" data-kid=\"1-1-2-1-2-2-2-4-3-2-1\" data-name=\"location pin icon\">\n                                        </i>\n                                        Baywalk Entrance, Manila\n                                    </span>\n                                </div>\n                                <div class=\"available-text\" data-kid=\"1-1-2-1-2-2-2-4-4\" data-name=\"availability status\">\n                                    <span class=\"available-dot\" data-kid=\"1-1-2-1-2-2-2-4-4-1\" data-name=\"status dot\">\n                                    </span>\n                                    18 of 35 places available\n                                </div>\n                                <a class=\"action-button\" data-kid=\"1-1-2-1-2-2-2-4-5\" data-name=\"cta button\" href=\"#student\">\n                                    View activity details\n                                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-1-2-1-2-2-2-4-5-1\" data-name=\"arrow icon\">\n                                    </i>\n                                </a>\n                            </section>\n                            <section aria-label=\"Service hour summary\" class=\"service-summary\" data-kid=\"1-1-2-1-2-2-2-5\" data-name=\"service summary section\">\n                                <div class=\"summary-item\" data-kid=\"1-1-2-1-2-2-2-5-1\" data-name=\"summary card\">\n                                    <span class=\"summary-value\" data-kid=\"1-1-2-1-2-2-2-5-1-1\" data-name=\"summary count\">\n                                        7\n                                    </span>\n                                    <span class=\"summary-copy\" data-kid=\"1-1-2-1-2-2-2-5-1-2\" data-name=\"summary description\">\n                                        <strong data-kid=\"1