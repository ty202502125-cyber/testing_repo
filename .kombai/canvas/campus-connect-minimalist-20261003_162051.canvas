                    </span>\n                        <span data-kid=\"1-1-3-2-1-5-2\" data-name=\"sidebar user info\">\n                            <strong data-kid=\"1-1-3-2-1-5-2-1\" data-name=\"sidebar user name\">\n                                Maya Santos\n                            </strong>\n                            <small data-kid=\"1-1-3-2-1-5-2-2\" data-name=\"sidebar user role\">\n                                Student volunteer\n                            </small>\n                        </span>\n                    </div>\n                </aside>\n                <div class=\"app-main\" data-kid=\"1-1-3-2-2\" data-name=\"student main content container\">\n                    <div class=\"app-topbar\" data-kid=\"1-1-3-2-2-1\" data-name=\"student top bar\">\n                        <div class=\"crumb\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"student breadcrumb container\">\n                            <span data-kid=\"1-1-3-2-2-1-1-1\" data-name=\"breadcrumb parent\">\n                                Student space\n                            </span>\n                            <b data-kid=\"1-1-3-2-2-1-1-2\" data-name=\"breadcrumb current page\">\n                                Overview\n                            </b>\n                        </div>\n                        <div class=\"top-account\" data-kid=\"1-1-3-2-2-1-2\" data-name=\"student top bar user account\">\n                            <span class=\"avatar\" data-kid=\"1-1-3-2-2-1-2-1\" data-name=\"student top bar user avatar\">\n                                MS\n                            </span>\n                            Maya Santos\n                        </div>\n                    </div>\n                    <div class=\"workspace\" data-kid=\"1-1-3-2-2-2\" data-name=\"student workspace\">\n                        <div class=\"workspace-title\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"workspace title container\">\n                            <div data-kid=\"1-1-3-2-2-2