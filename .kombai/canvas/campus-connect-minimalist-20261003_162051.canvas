817\n                                        </span>\n                                    </div>\n                                    <div class=\"claim-line\" data-kid=\"1-1-4-2-2-2-2-2-4-2\" data-name=\"claim details line\">\n                                        Reading Buddies ·\n                                        <b data-kid=\"1-1-4-2-2-2-2-2-4-2-1\" data-name=\"claim hours label\">\n                                            1.5 hours\n                                        </b>\n                                    </div>\n                                    <div class=\"claim-meta\" data-kid=\"1-1-4-2-2-2-2-2-4-3\" data-name=\"claim status\">\n                                        Pending\n                                    </div>\n                                    <div class=\"queue-actions\" data-kid=\"1-1-4-2-2-2-2-2-4-4\" data-name=\"action button group\">\n                                        <button class=\"approve\" data-kid=\"1-1-4-2-2-2-2-2-4-4-1\" data-name=\"approve button\">\n                                            Approve\n                                        </button>\n                                        <button class=\"decline\" data-kid=\"1-1-4-2-2-2-2-2-4-4-2\" data-name=\"decline button\">\n                                            Decline\n                                        </button>\n                                    </div>\n                                </article>\n                                <p class=\"admin-footer\" data-kid=\"1-1-4-2-2-2-2-2-5\" data-name=\"queue footer note\">\n                                    Review the activity and hours before approving a submission.\n                                </p>\n                            </aside>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"board-end\" data-kid=\"1-1-5\" data-name=\"footer\">\n            <span data-kid=\"1-1-5-1\" data-name=\"footer copyright branding\">\n                <strong data-kid=\"1-1-5-1-1\" data-name=\"footer brand name\">\n                    Campus Connect\n                </strong>\n                · Shared date structure, role-specific tasks\n            </span>\n            <span data-kid=\"1-1-5-2\" data-name=\"footer description\">\n                Green identity · Warm editorial type · Explicit availability\n            </span>\n        </footer>\n    </div>\n</main>\n",
