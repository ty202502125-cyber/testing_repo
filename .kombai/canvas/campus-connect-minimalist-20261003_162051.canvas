      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.font-canvas-sans { font-family: 'DM Sans', sans-serif; }\n.font-canvas-display { font-family: 'Newsreader', Georgia, serif; }\n</style>\n<div class=\"font-canvas-sans min-h-screen bg-[#F4F5F0] text-[#24332B] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"mx-auto max-w-[1440px] px-12 py-12\" data-kid=\"1-1\" data-name=\"page width constraint container\">\n        <header class=\"mb-10 flex items-end justify-between gap-10 border-b border-[#DCE2DA] pb-8\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div class=\"max-w-[780px]\" data-kid=\"1-1-1-1\" data-name=\"header content area\">\n                <div class=\"mb-7 flex items-center gap-3\" data-kid=\"1-1-1-1-1\" data-name=\"brand identity container\">\n                    <span class=\"grid h-10 w-10 place-items-center rounded-xl bg-[#14695A] font-canvas-display text-2xl font-semibold text-white\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon\">\n                        C\n                    </span>\n                    <span class=\"text-[17px] font-semibold tracking-[-0.03em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name text\">\n                        Campus\n                        <span class=\"font-normal text-[#65736A]\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand suffix text\">\n                            Connect\n                        </span>\n                    </span>\n                </div>\n                <h1 class=\"font-canvas-display text-[48px] font-medium leading-[1.02] tracking-[-0.035em] text-[#20372C]\" data-kid=\"1-1-1-1-2\" data-name=\"hero headline text\">\n                    A clearer record of every hour.\n                </h1>\n                <p class=\"mt-4 max-w-[690px] text-[16px] leading-7 text-[#526158]\" data-kid=\"1-1-1-1-3\" data-name=\"hero subheadline text\">\n                    Student contributions and admin reviews, organized by what has been approved, what still needs review, and what can happen next.\n                </p>\n            </div>\n            <div aria-label=\"Campus Connect visual palette\" class=\"mb-1 hidden shrink-0 items-center gap-3 md:flex\" data-kid=\"1-1-1-2\" data-name=\"visual palette indicator\">\n                <span class=\"h-7 w-7 rounded-full bg-[#14695A]\" data-kid=\"1-1-1-2-1\" data-name=\"color swatch forest\">\n                </span>\n                <span class=\"h-7 w-7 rounded-full bg-[#E9EFE8]\" data-kid=\"1-1-1-2-2\" data-name=\"color swatch paper\">\n                </span>\n                <span class=\"h-7 w-7 rounded-full bg-[#C9A968]\" data-kid=\"1-1-1-2-3\" data-name=\"color swatch warm brass\">\n                </span>\n                <span class=\"ml-1 text-[13px] text-[#68766D]\" data-kid=\"1-1-1-2-4\" data-name=\"palette description text\">\n                    Forest · paper · warm brass\n                </span>\n            </div>\n        </header>\n        <section class=\"mb-5 flex items-baseline justify-between gap-5\" data-kid=\"1-1-2\" data-name=\"section header\">\n            <h2 class=\"font-canvas-display text-[28px] font-medium tracking-[-0.025em] text-[#20372C]\" data-kid=\"1-1-2-1\" data-name=\"section headline text\">\n                One system, two clear roles\n            </h2>\n            <p class=\"text-[14px] text-[#647168]\" data-kid=\"1-1-2-2\" data-name=\"section description text\">\n                Service status stays visible across student records and admin review.\n            </p>\n        </section>\n        <section aria-label=\"Student and admin dashboard previews\" class=\"grid grid-cols-1 gap-7 xl:grid-cols-2\" data-kid=\"1-1-3\" data-name=\"dashboard preview grid\">\n            <!-- Student workspace preview -->\n            <article class=\"overflow-hidden rounded-[18px] border border-[#DBE1D9] bg-white shadow-[0_8px_30px_rgba(35,51,43,0.07)]\" data-kid=\"1-1-3-1\" data-name=\"student dashboard preview\">\n                <div class=\"flex items-center justify-between border-b border-[#E2E7E0] bg-[#FBFCF9] px-6 py-4\" data-kid=\"1-1-3-1-1\" data-name=\"student dashboard header\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-1-1-1\" data-name=\"brand identity container\">\n                        <span class=\"grid h-8 w-8 place-items-center rounded-[9px] bg-[#14695A] font-canvas-display text-[18px] font-semibold text-white\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"brand logo icon\">\n                            C\n                        </span>\n                        <span class=\"text-[14px] font-semibold tracking-[-0.02em]\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"brand name text\">\n                            Campus Connect\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2 rounded-full border border-[#DDE4DC] px-3 py-1.5 text-[12px] text-[#55645A]\" data-kid=\"1-1-3-1-1-2\" data-name=\"user profile badge\">\n                        <span class=\"grid h-6 w-6 place-items-center rounded-full bg-[#E9EFE8] text-[10px] font-bold text-[#35644D]\" data-kid=\"1-1-3-1-1-2-1\" data-name=\"user initials icon\">\n                            MS\n                        </span>\n                        Maya Santos\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-[188px_minmax(0,1fr)]\" data-kid=\"1-1-3-1-2\" data-name=\"main layout structure\">\n                    <aside class=\"flex min-h-[740px] flex-col border-r border-[#E4E8E2] bg-[#FAFBF8] px-4 py-6\" data-kid=\"1-1-3-1-2-1\" data-name=\"sidebar navigation\">\n                        <p class=\"mb-3 px-3 text-[12px] font-semibold text-[#78847B]\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"sidebar group label\">\n                            Student space\n                        </p>\n                        <nav aria-label=\"Student navigation\" class=\"grid gap-1.5 text-[14px]\" data-kid=\"1-1-3-1-2-1-2\" data-name=\"navigation menu\">\n                            <a class=\"flex min-h-11 items-center gap-3 rounded-lg bg-[#E8F0E9] px-3 font-semibold text-[#176452]\" data-kid=\"1-1-3-1-2-1-2-1\" data-name=\"navigation link overview\" href=\"#student\">\n                                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-3-1-2-1-2-1-1\" data-name=\"dashboard icon\">\n                                </i>\n                                Overview\n                            </a>\n                            <a class=\"flex min-h-11 items-center gap-3 rounded-lg px-3 text-[#526158]\" data-kid=\"1-1-3-1-2-1-2-2\" data-name=\"navigation link discover\" href=\"#activities\">\n                                <i aria-hidden=\"true\" class=\"ti ti-compass text-[17px]\" data-kid=\"1-1-3-1-2-1-2-2-1\" data-name=\"compass icon\">\n                                </i>\n                                Discover activities\n                            </a>\n                            <a class=\"flex min-h-11 items-center gap-3 rounded-lg px-3 text-[#526158]\" data-kid=\"1-1-3-1-2-1-2-3\" data-name=\"navigation link record\" href=\"#record\">\n                                <i aria-hidden=\"true\" class=\"ti ti-notes text-[17px]\" data-kid=\"1-1-3-1-2-1-2-3-1\" data-name=\"notes icon\">\n                                </i>\n                                My service record\n                            </a>\n                        </nav>\n                        <div class=\"mt-auto border-t border-[#E4E8E2] pt-5\" data-kid=\"1-1-3-1-2-1-3\" data-name=\"user account info\">\n                            <div class=\"flex items-center gap-3 px-1\" data-kid=\"1-1-3-1-2-1-3-1\" data-name=\"user profile avatar\">\n                                <span class=\"grid h-9 w-9 place-items-center rounded-full bg-[#E7EEE7] text-[12px] font-bold text-[#28634E]\" data-kid=\"1-1-3-1-2-1-3-1-1\" data-name=\"user initials icon\">\n                                    MS\n                                </span>\n                                <span data-kid=\"1-1-3-1-2-1-3-1-2\" data-name=\"user name and role info\">\n                                    <b class=\"block text-[13px] font-semibold\" data-kid=\"1-1-3-1-2-1-3-1-2-1\" data-name=\"user display name\">\n                                        Maya Santos\n                                    </b>\n                                    <small class=\"text-[12px] text-[#68766D]\" data-kid=\"1-1-3-1-2-1-3-1-2-2\" data-name=\"user role label\">\n                                        Student volunteer\n                                    </small>\n                                </span>\n                            </div>\n                        </div>\n                    </aside>\n                    <main class=\"min-w-0 px-7 py-7\" data-kid=\"1-1-3-1-2-2\" data-name=\"main content area\" id=\"student\">\n                        <div class=\"mb-6\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"welcome section\">\n                            <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-3-1-2-2-1-1\" data-name=\"header flex container\">\n                                <div data-kid=\"1-1-3-1-2-2-1-1-1\" data-name=\"breadcrumb and headline group\">\n                                    <p class=\"mb-1 text-[13px] text-[#68766D]\" data-kid=\"1-1-3-1-2-2-1-1-1-1\" data-name=\"breadcrumb path\">\n                                        Student space\n                                        <span class=\"px-1 text-[#A0AAA1]\" data-kid=\"1-1-3-1-2-2-1-1-1-1-1\" data-name=\"breadcrumb separator\">\n                                            /\n                                        </span>\n                                        Overview\n                                    </p>\n                                    <h3 class=\"font-canvas-display text-[33px] font-medium leading-tight tracking-[-0.03em] text-[#20372C]\" data-kid=\"1-1-3-1-2-2-1-1-1-2\" data-name=\"greeting headline\">\n                                        Good morning, Maya\n                                    </h3>\n                                    <p class=\"mt-2 text-[14px] leading-6 text-[#5D6A60]\" data-kid=\"1-1-3-1-2-2-1-1-1-3\" data-name=\"greeting subtext\">\n                                        Your hours, in one place.\n                                    </p>\n                                </div>\n                                <span class=\"mt-1 hidden rounded-full border border-[#DDE4DC] px-3 py-1.5 text-[12px] text-[#58675D] sm:inline-flex\" data-kid=\"1-1-3-1-2-2-1-1-2\" data-name=\"term badge\">\n                                    Fall 2026\n                                </span>\n                            </div>\n                        </div>\n                        <section aria-label=\"Service hour summary\" class=\"mb-7 border-y border-[#E2E7E0] py-5\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"hour summary section\">\n                            <div class=\"grid grid-cols-[1fr_auto_1.15fr] items-center gap-5\" data-kid=\"1-1-3-1-2-2-2-1\" data-name=\"summary grid\">\n                                <div data-kid=\"1-1-3-1-2-2-2-1-1\" data-name=\"approved hours container\">\n                                    <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-3-1-2-2-2-1-1-1\" data-name=\"approved hours count\">\n                                        <strong class=\"font-canvas-display text-[45px] font-medium leading-none tracking-[-0.04em] text-[#1C4D3D]\" data-kid=\"1-1-3-1-2-2-2-1-1-1-1\" data-name=\"approved hours digit\">\n                                            7\n                                        </strong>\n                                        <span class=\"text-[15px] font-medium text-[#425349]\" data-kid=\"1-1-3-1-2-2-2-1-1-1-2\" data-name=\"approved hours label\">\n                                            approved hours\n                                        </span>\n                                    </div>\n                                    <p class=\"mt-2 text-[13px] text-[#66736A]\" data-kid=\"1-1-3-1-2-2-2-1-1-2\" data-name=\"contributions count\">\n                                        Across 2 approved contributions\n                                    </p>\n                                </div>\n                                <div class=\"h-14 w-px bg-[#E1E6DF]\" data-kid=\"1-1-3-1-2-2-2-1-2\" data-name=\"divider line\">\n                                </div>\n                                <div data-kid=\"1-1-3-1-2-2-2-1-3\" data-name=\"pending hours container\">\n                                    <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-3-1-2-2-2-1-3-1\" data-name=\"pending hours count\">\n                                        <strong class=\"font-canvas-display text-[34px] font-medium leading-none tracking-[-0.03em] text-[#947334]\" data-kid=\"1-1-3-1-2-2-2-1-3-1-1\" data-name=\"pending hours digit\">\n                                            1\n                                        </strong>\n                                        <span class=\"text-[14px] font-medium text-[#48574D]\" data-kid=\"1-1-3-1-2-2-2-1-3-1-2\" data-name=\"pending hours label\">\n                                            submission awaiting review\n                                        </span>\n                                    </div>\n                                    <p class=\"mt-2 text-[13px] text-[#66736A]\" data-kid=\"1-1-3-1-2-2-2-1-3-2\" data-name=\"pending hours description\">\n                                        2.5 hours submitted\n                                    </p>\n                                </div>\n                            </div>\n                        </section>\n                        <section class=\"mb-7\" data-kid=\"1-1-3-1-2-2-3\" data-name=\"service record section\" id=\"record\">\n                            <div class=\"mb-2 flex items-baseline justify-between gap-3\" data-kid=\"1-1-3-1-2-2-3-1\" data-name=\"section title group\">\n                                <h4 class=\"font-canvas-display text-[22px] font-medium tracking-[-0.02em] text-[#24382D]\" data-kid=\"1-1-3-1-2-2-3-1-1\" data-name=\"section title\">\n                                    Service record\n                                </h4>\n                                <a class=\"text-[13px] font-semibold text-[#176452] underline decoration-[#A6C2B3] underline-offset-4\" data-kid=\"1-1-3-1-2-2-3-1-2\" data-name=\"view record link\" href=\"#full-record\">\n                                    View full record\n                                </a>\n                            </div>\n                            <p class=\"mb-2 text-[12px] text-[#68766D]\" data-kid=\"1-1-3-1-2-2-3-2\" data-name=\"column header description\">\n                                Date on record · activity · hours · current status\n                            </p>\n                            <div class=\"divide-y divide-[#E9ECE7]\" data-kid=\"1-1-3-1-2-2-3-3\" data-name=\"service record list\">\n                                <div class=\"grid grid-cols-[minmax(0,1fr)_65px_102px] items-center gap-3 py-3\" data-kid=\"1-1-3-1-2-2-3-3-1\" data-name=\"record entry\">\n                                    <div data-kid=\"1-1-3-1-2-2-3-3-1-1\" data-name=\"entry info\">\n                                        <p class=\"text-[14px] font-semibold text-[#283A30]\" data-kid=\"1-1-3-1-2-2-3-3-1-1-1\" data-name=\"activity name\">\n                                            Park Tree Planting\n                                        </p>\n                                        <p class=\"mt-0.5 text-[12px] text-[#6A766D]\" data-kid=\"1-1-3-1-2-2-