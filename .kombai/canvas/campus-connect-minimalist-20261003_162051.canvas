s=\"date-full\" data-kid=\"1-1-3-2-2-2-2-1-2-3-1-2\" data-name=\"date day number\">\n                                                Oct 11\n                                            </div>\n                                        </div>\n                                        <div data-kid=\"1-1-3-2-2-2-2-1-2-3-2\" data-name=\"event details container\">\n                                            <div class=\"event-top\" data-kid=\"1-1-3-2-2-2-2-1-2-3-2-1\" data-name=\"event header\">\n                                                <h5 class=\"event-name\" data-kid=\"1-1-3-2-2-2-2-1-2-3-2-1-1\" data-name=\"event name\">\n                                                    Campus Garden Day\n                                                </h5>\n                                                <span class=\"event-category\" data-kid=\"1-1-3-2-2-2-2-1-2-3-2-1-2\" data-name=\"event category label\">\n                                                    Campus Care\n                                                </span>\n                                            </div>\n                                            <div class=\"event-meta\" data-kid=\"1-1-3-2-2-2-2-1-2-3-2-2\" data-name=\"event location and time\">\n                                                9:00 AM–12:00 PM · North Quad Garden\n                                            </div>\n                                            <div class=\"event-bottom\" data-kid=\"1-1-3-2-2-2-2-1-2-3-2-3\" data-name=\"event actions container\">\n                                                <span class=\"available\" data-kid=\"1-1-3-2-2-2-2-1-2-3-2-3-1\" data-name=\"event availability label\">\n                                                    12 places left · Open\n                                                </span>\n                                                <a class=\"student-action\" data-kid=\"1-1-3-2-2-2-2-1-2-3-2-3-2\" data-name=\"event details link\">\n                                        