    },
    "var_e6d9b8eaaf73": {
      "type": "variant",
      "label": "Campus week — agenda-first",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 1841
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;650;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap');\n.cc-board{--paper:#f4f4ef;--white:#fff;--ink:#1c2a24;--sub:#57665e;--quiet:#69786f;--line:#e4e8e2;--pine:#17634f;--pine-dark:#124d3e;--mint:#e9f1eb;--mint-2:#f3f7f2;--gold:#96630f;--gold-bg:#f7f0df;--red:#a23f36;--red-bg:#f7e9e7;--serif:'Newsreader',Georgia,serif;--sans:'DM Sans',Arial,sans-serif;min-height:100vh;background:var(--paper);color:var(--ink);font-family:var(--sans);padding:30px 32px 42px}\n.cc-board .board-wrap{max-width:1376px;margin:0 auto}\n.cc-board .board-mast{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dfe4dc;padding:2px 0 20px;margin-bottom:27px}\n.cc-board .board-brand{display:flex;align-items:center;gap:11px;font-weight:700;font-size:15px;letter-spacing:-.02em}\n.cc-board .brand-mark{width:34px;height:34px;display:grid;place-items:center;background:var(--pine);color:white;border-radius:9px;font-family:var(--serif);font-size:20px;font-weight:600}\n.cc-board .board-meta{font-size:13px;color:var(--quiet)}\n.cc-board .board-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:36px;margin-bottom:25px}\n.cc-board .board-intro h1{font-family:var(--serif);font-size:46px;line-height:1;margin:0 0 9px;font-weight:500;letter-spacing:-.035em;color:var(--ink)}\n.cc-board .board-intro p{margin:0;color:var(--sub);font-size:15px;line-height:1.55}\n.cc-board .board-note{width:340px;border-left:1px solid #b9c9bd;padding:3px 0 3px 16px;color:var(--sub);font-size:13px;line-height:1.55}\n.cc-board .preview-block{margin-top:28px}\n.cc-board .preview-label{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin:0 4px 10px}\n.cc-board .preview-label h2{font-family:var(--serif);font-size:22px;line-height:1.1;margin:0;font-weight:500;letter-spacing:-.02em}\n.cc-board .preview-label p{font-size:13px;color:var(--quiet);margin:0}\n.cc-board .screen{display:grid;grid-template-columns:228px minmax(0,1fr);min-height:700px;background:var(--white);border:1px solid #dfe4de;border-radius:14px;overflow:hidden;box-shadow:0 8px 24px rgba(24,46,34,.06)}\n.cc-board .screen-admin{min-height:720px}\n.cc-board .app-side{display:flex;flex-direction:column;background:#fbfcf9;border-right:1px solid var(--line);padding:24px 15px 16px}\n.cc-board .app-brand{display:flex;align-items:center;gap:10px;padding:0 7px 25px;font-size:14px;font-weight:700;letter-spacing:-.02em}\n.cc-board .app-brand .brand-mark{width:30px;height:30px;border-radius:8px;font-size:18px}\n.cc-board .brand-light{font-weight:500;color:var(--sub)}\n.cc-board .nav-label{font-size:12px;color:#718078;font-weight:600;padding:0 10px;margin:0 0 8px}\n.cc-board .nav-items{display:grid;gap:3px}\n.cc-board .nav-link{min-height:42px;display:flex;align-items:center;gap:10px;padding:0 11px;border-radius:7px;color:#53625a;font-size:13px;font-weight:500}\n.cc-board .nav-link svg{width:16px;height:16px;flex:none;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}\n.cc-board .nav-link.active{background:var(--mint);color:var(--pine-dark);font-weight:650}\n.cc-board .nav-link.active svg{color:var(--pine)}\n.cc-board .side-grow{flex:1;min-height:60px}\n.cc-board .account{display:flex;align-items:center;gap:10px;border-top:1px solid var(--line);padding:15px 8px 5px}\n.cc-board .avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#e6eee7;color:var(--pine-dark);font-size:11px;font-weight:700;flex:none}\n.cc-board .account strong{display:block;font-size:12px;font-weight:650;color:var(--ink);line-height:1.3}\n.cc-board .account small{display:block;font-size:11px;color:var(--quiet);margin-top:2px}\n.cc-board .app-main{min-width:0;background:#fff}\n.cc-board .app-topbar{height:56px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 29px;color:var(--quiet);font-size:12px}\n.cc-board .crumb{display:flex;align-items:center;gap:10px}\n.cc-board .crumb b{font-size:12px;color:var(--ink);font-weight:650;border-left:1px solid #d7dfd8;padding-left:10px}\n.cc-board .top-account{display:flex;align-items:center;gap:8px;font-size:12px;color:#49584f}\n.cc-board .top-account .avatar{width:28px;height:28px;font-size:10px}\n.cc-board .workspace{padding:26px 30px 30px;min-width:0}\n.cc-board .workspace-title{margin-bottom:22px;display:flex;justify-content:space-between;align-items:flex-end;gap:18px}\n.cc-board .workspace-title h3{font-family:var(--serif);font-size:30px;line-height:1.08;letter-spacing:-.025em;font-weight:500;margin:0 0 6px}\n.cc-board .workspace-title p{font-size:14px;line-height:1.5;color:var(--sub);margin:0}\n.cc-board .quiet-link{display:inline-flex;align-items:center;gap:7px;color:var(--pine);font-size:13px;font-weight:650;white-space:nowrap}\n.cc-board .quiet-link span{font-size:16px;line-height:1}\n.cc-board .student-layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(240px,.85fr);gap:36px;align-items:start}\n.cc-board .section-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:10px}\n.cc-board .section-head h4{margin:0;font-family:var(--serif);font-weight:500;font-size:22px;letter-spacing:-.02em}\n.cc-board .section-head span{font-size:13px;color:var(--quiet)}\n.cc-board .agenda-list{border-top:1px solid var(--line)}\n.cc-board .agenda-row{display:grid;grid-template-columns:82px minmax(0,1fr);gap:15px;padding:15px 2px 16px;border-bottom:1px solid var(--line)}\n.cc-board .date-cell{padding-top:1px}\n.cc-board .date-day{font-size:11px;line-height:1.2;font-weight:700;color:var(--pine);letter-spacing:.025em}\n.cc-board .date-full{font-size:20px;line-height:1.14;font-family:var(--serif);font-weight:500;margin-top:4px;white-space:nowrap}\n.cc-board .event-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n.cc-board .event-name{font-size:16px;line-height:1.28;font-weight:650;letter-spacing:-.015em;margin:0;color:var(--ink)}\n.cc-board .event-category{font-size:12px;color:var(--quiet);white-space:nowrap;padding-top:2px}\n.cc-board .event-meta{font-size:13px;line-height:1.45;color:var(--sub);margin-top:5px}\n.cc-board .event-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:8px}\n.cc-board .available{font-size:12px;font-weight:600;color:#386a4e}\n.cc-board .available::before{content:'';width:6px;height:6px;border-radius:50%;background:#4e8b62;display:inline-block;margin:0 7px 1px 0}\n.cc-board .student-action{font-size:12px;font-weight:650;color:var(--pine);white-space:nowrap}\n.cc-board .record-summary{border-left:1px solid var(--line);padding:4px 0 0 24px;margin-top:2px}\n.cc-board .record-summary h4{font-family:var(--serif);font-weight:500;font-size:21px;letter-spacing:-.02em;margin:0 0 19px}\n.cc-board .approved-value{font-family:var(--serif);font-weight:500;font-size:42px;letter-spacing:-.04em;line-height:1;color:var(--pine-dark)}\n.cc-board .approved-caption{font-size:13px;color:var(--sub);margin-top:4px}\n.cc-board .record-separator{height:1px;background:var(--line);margin:18px 0 14px}\n.cc-board .pending-label{font-size:13px;color:var(--quiet);margin-bottom:4px}\n.cc-board .pending-value{font-size:19px;line-height:1.3;font-weight:650;color:var(--ink)}\n.cc-board .record-note{font-size:12px;line-height:1.5;color:var(--sub);margin-top:6px}\n.cc-board .record-link{display:inline-flex;align-items:center;gap:6px;margin-top:19px;color:var(--pine);font-size:13px;font-weight:650}\n.cc-board .admin-layout{display:grid;grid-template-columns:minmax(0,1.38fr) minmax(350px,.94fr);gap:31px;align-items:start}\n.cc-board .admin-agenda .agenda-row{grid-template-columns:82px minmax(0,1fr);gap:12px;padding:13px 1px}\n.cc-board .admin-agenda .event-name{font-size:15px}\n.cc-board .admin-agenda .event-meta{font-size:12px;margin-top:4px}\n.cc-board .admin-agenda .event-category{font-size:11px}\n.cc-board .admin-agenda .event-bottom{margin-top:6px}\n.cc-board .admin-agenda .available{font-size:12px}\n.cc-board .event-controls{display:flex;align-items:center;gap:14px}\n.cc-board .edit-link,.cc-board .cancel-link{font-size:12px;font-weight:600;color:var(--pine);white-space:nowrap}\n.cc-board .cancel-link{color:#7a6156}\n.cc-board .full-state{font-size:12px;font-weight:650;color:var(--gold)}\n.cc-board .queue{border:1px solid #dfe7df;border-radius:10px;background:#fbfcf9;padding:20px 20px 10px}\n.cc-board .queue-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:0 0 13px;border-bottom:1px solid #dfe6de}\n.cc-board .queue-heading h4{font-family:var(--serif);font-weight:500;font-size:21px;letter-spacing:-.02em;margin:0}\n.cc-board .queue-count{font-size:13px;font-weight:650;color:var(--pine-dark);white-space:nowrap}\n.cc-board .queue-row{padding:14px 0 13px;border-bottom:1px solid #e4e9e3}\n.cc-board .queue-row:last-child{border-bottom:0}\n.cc-board .queue-person{display:flex;align-items:baseline;justify-content:space-between;gap:10px}\n.cc-board .queue-person strong{font-size:14px;font-weight:650;line-height:1.3;color:var(--ink)}\n.cc-board .student-id{font-size:11px;color:var(--quiet);white-space:nowrap}\n.cc-board .claim-line{font-size:13px;line-height:1.4;color:var(--sub);margin-top:3px}\n.cc-board .claim-line b{color:var(--ink);font-weight:650}\n.cc-board .claim-meta{font-size:12px;color:var(--quiet);margin-top:3px}\n.cc-board .queue-actions{display:flex;align-items:center;gap:8px;margin-top:10px}\n.cc-board .queue-actions button{height:38px;padding:0 13px;border-radius:6px;font-family:var(--sans);font-size:12px;font-weight:650;cursor:default}\n.cc-board .approve{background:var(--pine);border:1px solid var(--pine);color:white}\n.cc-board .decline{background:#fff;border:1px solid #d4ddd4;color:#4e5d53}\n.cc-board .admin-footer{font-size:12px;line-height:1.5;color:var(--quiet);margin:15px 0 1px}\n.cc-board .board-end{display:flex;align-items:center;justify-content:space-between;gap:24px;border-top:1px solid #dfe4dc;margin-top:27px;padding-top:16px;color:var(--quiet);font-size:12px}\n.cc-board .board-end strong{font-weight:650;color:var(--sub)}\n@media(max-width:900px){.cc-board{padding:22px 16px 30px}.cc-board .board-intro{align-items:flex-start;flex-direction:column;gap:15px}.cc-board .board-note{width:auto}.cc-board .screen{grid-template-columns:190px minmax(0,1fr)}.cc-board .workspace{padding:22px 20px}.cc-board .student-layout,.cc-board .admin-layout{grid-template-columns:1fr}.cc-board .record-summary{border-left:0;border-top:1px solid var(--line);padding:18px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:9px 24px}.cc-board .record-summary h4{grid-column:1/-1;margin:0}.cc-board .record-separator{display:none}.cc-board .record-link{grid-column:1/-1;margin-top:5px}.cc-board .queue{margin-top:0}}\n@media(max-width:600px){.cc-board .board-mast{align-items:flex-start}.cc-board .board-meta{max-width:110px;text-align:right}.cc-board .board-intro h1{font-size:38px}.cc-board .screen,.cc-board .screen-admin{grid-template-columns:1fr;min-height:unset}.cc-board .app-side{padding:13px 14px;border-right:0;border-bottom:1px solid var(--line)}.cc-board .app-brand{padding:0 2px 11px}.cc-board .nav-label,.cc-board .side-grow,.cc-board .account{display:none}.cc-board .nav-items{display:flex;overflow:auto;gap:4px}.cc-board .nav-link{min-height:38px;white-space:nowrap;padding:0 9px}.cc-board .nav-link svg{display:none}.cc-board .app-topbar{padding:0 16px}.cc-board .workspace{padding:20px 16px}.cc-board .workspace-title{align-items:flex-start;flex-direction:column;gap:10px}.cc-board .agenda-row,.cc-board .admin-agenda .agenda-row{grid-template-columns:70px minmax(0,1fr);gap:10px}.cc-board .event-top{align-items:flex-start;flex-direction:column;gap:2px}.cc-board .event-bottom{align-items:flex-start;flex-direction:column;gap:8px}.cc-board .event-controls{gap:12px}.cc-board .queue{padding:16px 14px 8px}.cc-board .queue-person{align-items:flex-start;flex-direction:column;gap:2px}.cc-board .board-end{align-items:flex-start;flex-direction:column;gap:5px}}\n</style>\n<main class=\"cc-board\" data-kid=\"1\" data-name=\"main page container\">\n    <div class=\"board-wrap\" data-kid=\"1-1\" data-name=\"layout wrapper\">\n        <header class=\"board-mast\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div class=\"board-brand\" data-kid=\"1-1-1-1\" data-name=\"brand identity container\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon\">\n                    C\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Campus\n                    <span data-kid=\"1-1-1-1-2-1\" data-name=\"brand name subtitle\" style=\"font-weight:500;color:var(--sub)\">\n                        Connect\n                    </span>\n                </span>\n            </div>\n            <div class=\"board-meta\" data-kid=\"1-1-1-2\" data-name=\"header metadata text\">\n                Student volunteering · Product direction\n            </div>\n        </header>\n        <section class=\"board-intro\" data-kid=\"1-1-2\" data-name=\"introduction section\">\n            <div data-kid=\"1-1-2-1\" data-name=\"intro title and description container\">\n                <h1 data-kid=\"1-1-2-1-1\" data-name=\"page headline\">\n                    Campus week\n                </h1>\n                <p data-kid=\"1-1-2-1-2\" data-name=\"intro description text\">\n                    Opportunity planning and admin oversight, organized by date.\n                </p>\n            </div>\n            <div class=\"board-note\" data-kid=\"1-1-2-2\" data-name=\"intro callout note\">\n                The same agenda helps students choose where to volunteer and helps admins keep upcoming events accurate.\n            </div>\n        </section>\n        <section aria-label=\"Student overview preview\" class=\"preview-block\" data-kid=\"1-1-3\" data-name=\"student preview section\">\n            <div class=\"preview-label\" data-kid=\"1-1-3-1\" data-name=\"student section header\">\n                <h2 data-kid=\"1-1-3-1-1\" data-name=\"student section title\">\n                    Student overview\n                </h2>\n                <p data-kid=\"1-1-3-1-2\" data-name=\"student section description\">\n                    Upcoming activities lead; service hours stay in view.\n                </p>\n            </div>\n            <div class=\"screen\" data-kid=\"1-1-3-2\" data-name=\"student interface screen container\">\n                <aside class=\"app-side\" data-kid=\"1-1-3-2-1\" data-name=\"student sidebar container\">\n                    <div class=\"app-brand\" data-kid=\"1-1-3-2-1-1\" data-name=\"sidebar brand container\">\n                        <span class=\"brand-mark\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"sidebar brand icon\">\n                            C\n                        </span>\n                        <span data-kid=\"1-1-3-2-1-1-2\" data-name=\"sidebar brand name\">\n                            Campus\n                            <span class=\"brand-light\" data-kid=\"1-1-3-2-1-1-2-1\" data-name=\"sidebar brand subtitle\">\n                                Connect\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"nav-label\" data-kid=\"1-1-3-2-1-2\" data-name=\"sidebar nav section label\">\n                        Student space\n                    </div>\n                    <nav class=\"nav-items\" data-kid=\"1-1-3-2-1-3\" data-name=\"sidebar navigation links container\">\n                        <div class=\"nav-link active\" data-kid=\"1-1-3-2-1-3-1\" data-name=\"overview nav link\">\n                            <svg data-kid=\"1-1-3-2-1-3-1-1\" data-n